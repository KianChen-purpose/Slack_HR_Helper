# Copy this file to .env and fill in real values. Do not commit .env.

# --- Slack (required) ---
# Bot User OAuth Token from your Slack app's "OAuth & Permissions" page.
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token with the connections:write scope (required for Socket Mode).
# Create it under "Basic Information" -> "App-Level Tokens".
SLACK_APP_TOKEN=xapp-your-app-token

# --- Anthropic / Claude (required) ---
ANTHROPIC_API_KEY=sk-ant-your-api-key

# --- Anthropic / Claude (optional) ---
# Model to use. Default is claude-opus-5-5.
# claude-sonnet-5-5 is a strong, lower-cost alternative.
ANTHROPIC_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max. Default is low
# (grounded Q&A over the playbook does not need high effort).
HR_BOT_EFFORT=low
